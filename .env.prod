# ============================================================================
# Axiom CRM — PROD environment
#
# Committed deliberately, matching the house convention used by the sibling
# Octane platform: one file per environment, versioned so a new machine is
# reproducible without out-of-band setup.
#
# BEFORE A REAL PRODUCTION DEPLOYMENT these values must be rotated and moved to
# a secret manager. A committed production password is readable by anyone with
# repository access, and repository access is a much larger group than database
# access should ever be.
# ============================================================================

SPRING_PROFILES_ACTIVE=prod
AXIOM_ENVIRONMENT=prod

# --- Database -------------------------------------------------------------
AXIOM_DB_HOST=host.docker.internal
AXIOM_DB_PORT=5432
AXIOM_DB_NAME=AxiomCrmdb_Prod

# Owner / migration identity. Flyway runs as this role; it owns the schema and
# defines the row-level security policies.
AXIOM_DB_USER=Axiom
AXIOM_DB_PASSWORD=Axiom@12345

# Runtime identity. Every authenticated request runs as this least-privilege
# role, which is SUBJECT to row-level security — that is the whole point of
# ADR-001. It must never be the owner, because owners bypass RLS.
SPRING_DATASOURCE_USERNAME=axiom_app
SPRING_DATASOURCE_PASSWORD=axiom_app_dev_password

# Outbox relay identity (ADR-003). Cross-tenant on outbox_event and nothing else.
AXIOM_RELAY_DATASOURCE_USERNAME=axiom_relay
AXIOM_RELAY_DATASOURCE_PASSWORD=axiom_relay_dev_password

# --- Messaging ------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AXIOM_OUTBOX_TOPIC=axiom.domain-events

# --- Security -------------------------------------------------------------
# JwtService refuses to start on a non-dev/test profile if this is absent or
# left at the committed development default.
AXIOM_JWT_SECRET=axiom-prod-signing-key-replace-before-production-use-32b
AXIOM_JWT_TTL_MINUTES=480

# --- Web ------------------------------------------------------------------
AXIOM_CORS_ORIGINS=http://localhost:5173,http://localhost:4280
AXIOM_API_PORT=8080
